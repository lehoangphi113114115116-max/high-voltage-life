  "scenes": [
    {
      "id": "sentence-0",
      "text": "Tại nhà máy điện, máy phát biến cơ năng thành điện năng.",
      "mode": "depth",
      "startFrame": 0,
      "endFrame": 105,
      "transition": "directional-reveal",
      "camera": "parallax-dolly"
    },
    {
      "id": "sentence-1",
      "text": "Sau đó, máy biến áp nâng điện áp, giúp giảm tổn thất khi truyền tải đi xa.",
      "mode": "depth",
      "startFrame": 114,
      "endFrame": 214,
      "transition": "cross-dissolve",
      "camera": "parallax-dolly"
    },
    {
      "id": "sentence-2",
      "text": "Qua đường dây đến khu dân cư, điện áp được hạ xuống nhiều cấp, rồi phân phối qua công tơ để thắp sáng nhà bạn.",
      "mode": "depth",
